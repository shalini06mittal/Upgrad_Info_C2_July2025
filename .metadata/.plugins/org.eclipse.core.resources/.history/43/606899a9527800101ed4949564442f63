package testing;

public class Mathematical {

	public int add(int i, int j) {
		// TODO Auto-generated method stub
		return i+j;
	}
	public int sub(int i, int j) {
		// TODO Auto-generated method stub
		if(i>j)
			return i-j;
		return j-i;
	}
	
	public double sqrt(int no) throws Exception {
		if(no<=0)
			throw new Exception("No cannot be <= 0");
		return Math.sqrt(no);
	}

}
