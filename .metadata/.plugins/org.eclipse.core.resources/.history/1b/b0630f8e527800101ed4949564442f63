package testing;

import static org.junit.jupiter.api.Assertions.assertEquals;

import org.junit.jupiter.api.Test;
// DO NOT FORGET TO ADD JUNIT5 LIBRARY IN THE PATH
public class MathematicalTest {
	Mathematical mathematical;
	public void beforeEach() {
		 mathematical = new Mathematical();
	}
	
	@Test
	public void testAddReturnsResult() {
		
		
		int expected = 30;
		int actual = mathematical.add(10, 20);
		
		// assertions
		assertEquals(expected, actual);
		
	}
	@Test
	public void testSubReturnsResult() {
		Mathematical mathematical = new Mathematical();
		
		int expected = 10;
		int actual = mathematical.sub(10, 20);
		
		// assertions
		assertEquals(expected, actual);
		
	}
	@Test
	public void testSqrtReturnsResult() throws Exception {
		
		Mathematical mathematical = new Mathematical();
		int expected = 4;
		double actual = mathematical.sqrt(16);
		
		// assertions
		assertEquals(expected, actual);
	}
	
}
