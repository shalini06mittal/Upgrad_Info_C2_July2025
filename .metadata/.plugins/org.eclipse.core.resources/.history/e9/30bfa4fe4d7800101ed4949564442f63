	public Customer insertCustomer(Customer customer) {
		String sql = "insert into customer(name,email,password)"
				+ " values('"+customer.getName() +"',"
				+"'"+customer.getEmail() +"',"
				+"'"+customer.getPassword() +"'"
				+")";
		System.out.println(sql);
		
		Customer savedCustomer = null;
		
		//3. statement
		try {
			Statement statement = conn.createStatement();
			statement.executeUpdate(sql);
			
			savedCustomer = getLastInsertedCustomer();
			
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		return savedCustomer;
	}
	public Customer insertCustomerPreparedStatement(Customer customer) {
		String sql = "insert into customer(name,email,password) values(?,?,?)";
		System.out.println(sql);
		
		Customer savedCustomer = null;
		
		//3. statement
		try {
			PreparedStatement statement = conn.prepareStatement(sql);
			statement.setString(1, customer.getName());
			statement.setString(2, customer.getEmail());
			statement.setString(3, customer.getPassword());
			statement.executeUpdate();
			savedCustomer = getLastInsertedCustomer();
			
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		return savedCustomer;
	}
	public Customer getLastInsertedCustomer() {
		String sql = "SELECT * FROM customer order by id desc limit 1";
		Statement statement;
		Customer customer = null;
		try {
			statement = conn.createStatement();
			ResultSet rs = statement.executeQuery(sql);
			if(rs.next()) {
				customer = new Customer();
				customer.setId(rs.getInt(1));
				customer.setName(rs.getString(2));
				customer.setEmail(rs.getString(3));
				customer.setPassword(rs.getString(4));
			}
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		return customer;
		
	}
